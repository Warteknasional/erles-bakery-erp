# ─────────────────────────────────────────────────────────────
# Erles Bakery ERP — Docker Compose & Environment Example
# ─────────────────────────────────────────────────────────────
# Salin file ini ke backend/.env jika menjalankan backend secara lokal
# atau gunakan docker compose up untuk menjalankan seluruh service.

APP_NAME="Erles Bakery ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=erles_bakery
DB_USERNAME=postgres
DB_PASSWORD=postgres
QUEUE_CONNECTION=database

SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:5174,127.0.0.1:5173,127.0.0.1:5174
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Telegram Bot Notification (Owner / Admin)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# WAHA (WhatsApp HTTP API - Customer WA Orders)
WAHA_URL=http://waha:3000
WAHA_SESSION=default
WAHA_API_KEY=
WAHA_WEBHOOK_SECRET=
